    "expo-font": "~58.0.9",
    "expo-glass-effect": "~58.0.4",
    "expo-image": "~58.0.16",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-print": "~58.0.7",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.19",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schemas": "tsx scripts/generate-schemas.ts",
    "export:web": "expo export --platform web",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "private": true,
  "description": "Offline-first, interoperable stock, customer and ledger app for private gold jewellers.",
  "license": "MIT",
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  }
